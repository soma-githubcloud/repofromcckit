{
  "name": "playwright-greenfieldproject",
  "version": "1.0.0",
  "private": true,
  "description": "Generated by automation-kit | Kit: kit-u1 | testStyle: both",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@faker-js/faker": "^8.4.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "allure-cucumberjs": "^3.5.0",
    "allure-playwright": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:bdd": "cucumber-js",
    "test:bdd:smoke": "cucumber-js --tags @smoke",
    "test:bdd:dry": "cucumber-js --dry-run",
    "test:allure": "playwright test && npm run allure:generate",
    "allure:generate": "allure generate --output allure-report allure-results",
    "allure:open": "allure open allure-report",
    "report": "playwright show-report",
    "lint": "tsc --noEmit",
    "clean": "rimraf allure-results allure-report playwright-report test-results"
  }
}